# Copy file nay thanh .env va dien Clerk Publishable Key cua ban.
#
# GIAI DOAN DEV NHOM: file .env duoc commit len git de team de chia se key.
# DEN KHI BAO CAO/DEPLOY THAT: chinh sua .gitignore (xem ghi chu cuoi file)
# de an .env va clerk-keys.js, dong thoi rotate keys tren Clerk Dashboard.

# Clerk (login frontend)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev

# Optional - URL cua admin backend (deploy ra cloud).
# Local de trong, mac dinh http://localhost:4000/api/admin.
# Vi du: ADMIN_API_BASE=https://your-tunnel.ngrok-free.app/api/admin
ADMIN_API_BASE=
