# Copy file nay thanh .env va dien Clerk Publishable Key cua ban.
# File .env KHONG bi commit len git (da gitignore qua rule .env va .env.*).
#
# Khi deploy Vercel: dat cac bien moi truong nay trong
# Project Settings -> Environment Variables.

# Clerk (login frontend)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev

# Optional - URL cua admin backend.
# Local de trong, mac dinh http://localhost:4000/api/admin.
# Khi deploy Vercel: chinh thanh URL backend public, vi du:
#   ADMIN_API_BASE=https://your-tunnel.ngrok-free.app/api/admin
#   ADMIN_API_BASE=https://mypuppy-admin.onrender.com/api/admin
ADMIN_API_BASE=
