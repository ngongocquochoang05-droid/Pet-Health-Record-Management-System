# Copy this file to BACKEND/.env and update it with your SQL Server information.

DB_CLIENT=sqlserver

# SQL Express local is configured to listen on TCP port 1433.
SQLSERVER_HOST=127.0.0.1
SQLSERVER_INSTANCE=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=PetHealth

# Recommended for backend code: SQL Server Authentication.
SQLSERVER_USER=mypuppy_user
SQLSERVER_PASSWORD=MyPuppy@123456

# Local development options.
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
