# Copy this file to BACKEND/.env and update it with your information.

DB_CLIENT=sqlserver

# SQL Server local.
SQLSERVER_HOST=127.0.0.1
SQLSERVER_INSTANCE=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=PetHealth

SQLSERVER_USER=mypuppy_user
SQLSERVER_PASSWORD=MyPuppy@123456

SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Clerk Backend API (server-side).
# Lay tai: https://dashboard.clerk.com -> API Keys -> Secret keys
# Khi co key, admin se goi Clerk de revoke session khi khoa user.
# Neu de trong, khoa user chi update DB, KHONG dang xuat khoi Clerk.
CLERK_SECRET_KEY=
