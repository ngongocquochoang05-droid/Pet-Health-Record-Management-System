{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Admin Backend",
      "type": "shell",
      "command": "dotnet",
      "args": ["run", "--project", "MyPuppy.Admin.csproj", "--no-launch-profile"],
      "options": {
        "cwd": "${workspaceFolder}/BACKEND/admin",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:4000"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "mypuppy-admin",
        "pattern": {
          "regexp": "^()()()()()$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application started\\."
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "mypuppy"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Stop Admin Backend",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-NetTCPConnection -LocalPort 4000 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Write-Output 'Admin backend stopped (if running).'"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Restart Admin Backend",
      "dependsOrder": "sequence",
      "dependsOn": ["Stop Admin Backend", "Start Admin Backend"]
    }
  ]
}
